# Bu dosyayı .env adıyla kopyala ve kendi değerlerini yaz.
# Supabase paneli > Project Settings > API (Data API / API Keys)
EXPO_PUBLIC_SUPABASE_URL=https://PROJE-KIMLIGI.supabase.co
# "Publishable" (ya da eski adıyla "anon public") anahtar.
# service_role / secret anahtarını ASLA buraya yazma.
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
