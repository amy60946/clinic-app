// Moyo Mercek web uygulaması (uzman paneli) → uzman.moyoapp.com.tr, taban yol "/", tek sayfa uygulaması.
// Derleme: bash tools/web/build-uzman.sh · Yayın: npx wrangler deploy -c wrangler.uzman.jsonc
// workers.dev ve sürüm önizleme adresleri kapalı: açık kalırsa uygulama Cloudflare Access kilidinin dışından herkese açılır.
// Route / özel alan adı burada yok; yönetim paneli penceresi ilk yayından sonra API ile bağlar (ortak CANLIYA_ALMA 1.2).
{
  "name": "moyo-uzman",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist-uzman", "not_found_handling": "single-page-application" }
}
